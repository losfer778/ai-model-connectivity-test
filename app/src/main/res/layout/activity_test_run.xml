<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:fitsSystemWindows="true"
	android:background="@color/surface">

	<com.google.android.material.appbar.MaterialToolbar
		android:id="@+id/toolbar"
		android:layout_width="match_parent"
		android:layout_height="?attr/actionBarSize"
		app:navigationIcon="@drawable/ic_back"
		app:title="连通测试" />

	<com.google.android.material.card.MaterialCardView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_margin="16dp"
		app:cardElevation="0dp"
		app:cardCornerRadius="24dp"
		app:strokeWidth="0dp"
		app:cardBackgroundColor="@color/surface_container_high">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:padding="20dp">

			<TextView
				android:id="@+id/progress_label"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="准备中"
				android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
				android:textColor="@color/on_surface" />

			<com.google.android.material.progressindicator.LinearProgressIndicator
				android:id="@+id/progress"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				app:trackCornerRadius="8dp"
				app:trackThickness="8dp" />

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:orientation="horizontal">

				<TextView
					android:id="@+id/chip_ok"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:background="@drawable/bg_chip_ok"
					android:paddingStart="12dp"
					android:paddingEnd="12dp"
					android:paddingTop="4dp"
					android:paddingBottom="4dp"
					android:text="正常 0"
					android:textColor="@color/success"
					android:textSize="13sp" />

				<TextView
					android:id="@+id/chip_fail"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginStart="8dp"
					android:background="@drawable/bg_chip_fail"
					android:paddingStart="12dp"
					android:paddingEnd="12dp"
					android:paddingTop="4dp"
					android:paddingBottom="4dp"
					android:text="异常 0"
					android:textColor="@color/error"
					android:textSize="13sp" />

				<TextView
					android:id="@+id/chip_elapsed"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginStart="8dp"
					android:background="@drawable/bg_chip_neutral"
					android:paddingStart="12dp"
					android:paddingEnd="12dp"
					android:paddingTop="4dp"
					android:paddingBottom="4dp"
					android:text="0s"
					android:textColor="@color/on_surface_variant"
					android:textSize="13sp" />
			</LinearLayout>
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>

	<androidx.recyclerview.widget.RecyclerView
		android:id="@+id/recycler"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:clipToPadding="false"
		android:paddingStart="16dp"
		android:paddingEnd="16dp"
		android:paddingBottom="8dp" />

	<com.google.android.material.button.MaterialButton
		android:id="@+id/btn_stop"
		style="@style/Widget.Material3.Button.TonalButton"
		android:layout_width="match_parent"
		android:layout_height="56dp"
		android:layout_margin="16dp"
		android:text="停止测试"
		app:icon="@drawable/ic_stop"
		app:iconGravity="textStart"
		app:cornerRadius="16dp" />
</LinearLayout>
